# Public non-secret environment template for SENTRY Desktop (campus_parking_desktop)
# Never store DATABASE_URL, PostgreSQL credentials, or raw biometric files here.
APP_ENV=local
DATA_SOURCE=mock
ROSTER_MODE=class_demo
API_BASE_URL=http://127.0.0.1:8000
WS_BASE_URL=ws://127.0.0.1:8000/api/v1/ws/updates
REQUEST_TIMEOUT_MS=5000
DISPLAY_TIMEZONE=Asia/Manila
